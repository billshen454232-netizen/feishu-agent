{
  "server": {
    "host": "127.0.0.1",
    "port": 8001
  },
  "runtime": {
    "role": "worker",
    "worker_id": "jenkins-worker-1",
    "worker_token": "填写与阿里云Gateway一致的高强度随机Bearer令牌",
    "gateway_base_url": "https://你的阿里云网关域名",
    "poll_interval_seconds": 5,
    "heartbeat_interval_seconds": 30,
    "lease_timeout_seconds": 180
  },
  "muliu": {
    "enabled": true,
    "routes": {
      "cn": {
        "identifier": "route-cn",
        "task_id": 100,
        "enabled": true,
        "base_url": "填写仅本机可见的国服 Muliu URL",
        "username": "填写国服 Muliu 账号",
        "password": "填写国服 Muliu 密码"
      },
      "overseas": {
        "identifier": "route-overseas",
        "task_id": 89,
        "enabled": true,
        "base_url": "填写仅本机可见的海外 Muliu URL",
        "username": "填写海外 Muliu 账号",
        "password": "填写海外 Muliu 密码"
      }
    },
    "step": 11,
    "script_index": 0,
    "parameter_index": 0,
    "log_wait_seconds": 5,
    "log_completion_timeout_seconds": 1800,
    "start_verification_wait_seconds": 60,
    "request_timeout_seconds": 20,
    "script_root": "/home/serverGeneralScript",
    "script_catalog_path": "config/muliu_script_catalog.md",
    "max_steps": 10
  },
  "server_manager": {
    "enabled": true,
    "env": "qa_test",
    "regions": {
      "cn": "https://cn-server-manager.example.com",
      "overseas": "https://overseas-server-manager.example.com"
    },
    "poll_interval_seconds": 3,
    "task_timeout_seconds": 900,
    "request_timeout_seconds": 30,
    "inventory_ttl_seconds": 600
  },
  "baye_check": {
    "enabled": false,
    "base_url": "http://ui-automation-executor.example.com:8899",
    "default_serial": "",
    "accounts_path": "config/baye_accounts.xlsx",
    "state_path": "data/baye_checks_pending.json",
    "poll_interval_seconds": 3,
    "timeout_seconds": 3600,
    "request_timeout_seconds": 30
  }
}
