# /etc/systemd/system/team-kb.service — 组内项目知识库：服务端搜索 + 网页上传（只监听 127.0.0.1，经 nginx 8090 的 /api/ 访问）
[Unit]
Description=Team knowledge base search/upload service
After=network.target

[Service]
# TEAM_KB_PUBLIC_URL（内网站点地址，给管理员的「内网查看全文」链接）写在 /opt/team-kb/team-kb.env，不进仓库
EnvironmentFile=-/opt/team-kb/team-kb.env
ExecStart=/usr/bin/python3 /opt/team-kb/tools/server.py --root /opt/team-kb --port 8091 --public-url=${TEAM_KB_PUBLIC_URL} --agent-config=/opt/feishu-agent/config/config.json
WorkingDirectory=/opt/team-kb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
