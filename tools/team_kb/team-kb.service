# /etc/systemd/system/team-kb.service — 组内项目知识库：服务端搜索 + 网页上传（只监听 127.0.0.1，经 nginx 8090 的 /api/ 访问）
[Unit]
Description=Team knowledge base search/upload service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/team-kb/tools/server.py --root /opt/team-kb --port 8091
WorkingDirectory=/opt/team-kb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
