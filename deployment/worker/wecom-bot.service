[Unit]
Description=WeCom duty sheet bot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/wecom-bot/bot.env

[Service]
Type=simple
User=wecom-bot
Group=wecom-bot
StateDirectory=wecom-bot
StateDirectoryMode=0700
WorkingDirectory=/opt/wecom-bot
EnvironmentFile=/etc/wecom-bot/bot.env
ExecStart=/usr/bin/node /opt/wecom-bot/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
